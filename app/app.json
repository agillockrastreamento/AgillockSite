{
  "expo": {
    "name": "Ágil Lock",
    "slug": "agillock-cliente",
    "version": "1.0.5",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#000000"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "br.com.agillock.cliente",
      "config": {
        "googleMapsApiKey": "AIzaSyDeyQ7JG_9nWLG2TmfR7WejJfYPjMgr5VA"
      },
      "infoPlist": {
        "NSFaceIDUsageDescription": "A AgilLock usa o Face ID / Touch ID para permitir um login mais rápido e seguro.",
        "ITSAppUsesNonExemptEncryption": false
      },
      "buildNumber": "14"
    },
    "android": {
      "package": "br.com.agillock.cliente",
      "googleServicesFile": "./google-services.json",
      "config": {
        "googleMaps": {
          "apiKey": "AIzaSyB9TMJqElRRY2DV2cADIj-Lo-2iqCQ_W5Y"
        }
      },
      "permissions": [
        "android.permission.USE_BIOMETRIC",
        "android.permission.USE_FINGERPRINT"
      ],
      "blockedPermissions": [
        "android.permission.SYSTEM_ALERT_WINDOW",
        "android.permission.WRITE_EXTERNAL_STORAGE"
      ],
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#000000"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false,
      "versionCode": 18
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-secure-store",
      [
        "expo-notifications",
        {
          "icon": "./assets/notification-icon.png",
          "color": "#F5A623"
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "A AgilLock acessa suas fotos apenas quando você escolhe uma imagem para perfil, veículo ou comprovantes dentro do app.",
          "cameraPermission": "A AgilLock usa a câmera para permitir o envio de fotos de perfil e fotos dos veículos vinculados à sua conta.",
          "microphonePermission": false
        }
      ],
      [
        "expo-local-authentication",
        {
          "faceIDPermission": "A AgilLock usa o Face ID / Touch ID para permitir um login mais rápido e seguro."
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "A AgilLock usa sua localização enquanto o app está em uso para centralizar o mapa e facilitar a visualização dos veículos próximos."
        }
      ],
      "@react-native-community/datetimepicker",
      [
        "react-native-ble-plx",
        {
          "isBackgroundEnabled": false,
          "neverForLocation": false,
          "modes": [
            "central"
          ],
          "bluetoothAlwaysPermission": "A AgilLock usa Bluetooth para localizar tags Bluetooth de veículos durante operações de resgate."
        }
      ]
    ],
    "extra": {
      "apiUrl": "https://api.agillock.com.br/api",
      "wsUrl": "wss://api.agillock.com.br/ws/rastreamento",
      "environment": "production",
      "eas": {
        "projectId": "63e4131c-1fd9-4366-9bf7-d2bbbfafabd2"
      }
    },
    "owner": "pedro_castro"
  }
}
