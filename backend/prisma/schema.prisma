generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  ADMIN
  COLABORADOR
  VENDEDOR
  RESGATE
}

enum StatusCliente {
  ATIVO
  INATIVO
}

enum TipoCarne {
  INDIVIDUAL
  UNIFICADO
}

enum StatusBoleto {
  PENDENTE
  PAGO
  ATRASADO
  CANCELADO
  REEMBOLSADO
}

model User {
  id        String   @id @default(uuid())
  nome      String
  email     String   @unique
  senhaHash String
  role      Role
  ativo     Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Permissões granulares para COLABORADOR (ignoradas para outros roles)
  podeExcluirCliente         Boolean @default(true)
  podeEditarCliente          Boolean @default(true)
  podeInativarCliente        Boolean @default(true)
  podeExcluirPlaca           Boolean @default(true)
  podeInativarPlaca          Boolean @default(true)
  podeExcluirDispositivo     Boolean @default(true)
  podeInativarDispositivo    Boolean @default(true)
  podeCriarDispositivo       Boolean @default(true)
  podeEditarDispositivo      Boolean @default(true)
  podeDesvincularDispositivo Boolean @default(true)
  podeBaixaManual            Boolean @default(true)
  podeCancelarCarne          Boolean @default(true)
  podeAlterarVencimento      Boolean @default(true)
  podeCriarContrato          Boolean @default(true)
  podeEditarContrato         Boolean @default(true)
  podeExcluirContrato        Boolean @default(true)
  podeAcessarMonitoramento   Boolean @default(false)
  // Permissões de login do cliente (padrão conservador para inativar/excluir)
  podeCriarLoginCliente      Boolean @default(true)
  podeEditarLoginCliente     Boolean @default(true)
  podeInativarLoginCliente   Boolean @default(false)
  podeExcluirLoginCliente    Boolean @default(false)

  manutencoesAdmin      ManutencaoRegistro[]        @relation("ManutencaoAdmin")
  recorrenciasAdmin     ManutencaoRecorrencia[]     @relation("RecorrenciaAdmin")
  recorrenciasDataAdmin ManutencaoRecorrenciaData[] @relation("RecorrenciaDataAdmin")
  clientesCriados       Cliente[]                   @relation("ClienteCriador")
  clientesVendidos      Cliente[]                   @relation("ClienteVendedor")
  carnesGerados         Carne[]                     @relation("CarneGeradoPor")
  carnesVendidos        Carne[]                     @relation("CarneVendedor")
  placasVendidas        Placa[]                     @relation("PlacaVendedor")
  dispositivosCriados   Dispositivo[]               @relation("DispositivoCriador")
  dispositivosVendidos  Dispositivo[]               @relation("DispositivoVendedor")
  comissoes             ComissaoVendedor[]
  pagamentos            PagamentoComissao[]
  contratosCriados      Contrato[]                  @relation("ContratoCriador")
  adminPreferencia      AdminPreferencia?
  dispositivosResgate   UsuarioResgateDispositivo[]
}

model AdminPreferencia {
  id        String   @id @default(uuid())
  userId    String   @unique
  prefs     Json     @default("{}")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Cliente {
  id             String        @id @default(uuid())
  nome           String
  cpfCnpj        String?
  telefone       String?
  email          String?
  notas          String?
  dataNascimento String?
  rg             String?
  profissao      String?
  estadoCivil    String?
  tipoPessoa     String        @default("PF")
  nirc           String?
  emailCobranca  String?
  origemCliente  String?
  socios         Json?
  status         StatusCliente @default(ATIVO)

  // Quando true, o cliente pode editar o odômetro/horímetro dos seus dispositivos
  // (mesmo modal do admin) pelo card flutuante do mapa (web) e bottom sheet (app).
  podeEditarMedidores Boolean @default(false)

  // Integração IAPRO — cliente criado/sincronizado a partir de um contrato da IAPRO.
  // Pagamentos desse cliente são feitos pela IAPRO (sem boletos na Ágil Lock).
  origemIapro    Boolean @default(false)
  iaproClienteId String? @unique
  cep            String?
  logradouro     String?
  numero         String?
  complemento    String?
  bairro         String?
  cidade         String?
  estado         String?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  criadoPorId String
  criadoPor   User    @relation("ClienteCriador", fields: [criadoPorId], references: [id])
  vendedorId  String?
  vendedor    User?   @relation("ClienteVendedor", fields: [vendedorId], references: [id])

  placas                 Placa[]
  dispositivos           Dispositivo[]
  dispositivosVinculados DispositivoCliente[]
  carnes                 Carne[]
  contratos              Contrato[]
  logins                 ClienteLogin[]
  geocercas              Geocerca[]
  iaproVeiculos          IaproVeiculo[]
}

// Veículo de um contrato da IAPRO sincronizado via API. Enquanto não houver um
// Dispositivo (rastreador) vinculado, o veículo conta como "sem rastreamento" na
// tela IAPRO do admin. Quando o dispositivo é vinculado ao cliente, dispositivoId
// é preenchido e a IAPRO é notificada (rastreador instalado).
model IaproVeiculo {
  id              String   @id @default(uuid())
  iaproVehicleId  String   @unique // id do Vehicle na IAPRO
  iaproContractId String? // id do Contract na IAPRO
  placa           String?
  marca           String?
  modelo          String?
  cor             String?
  ano             String?
  ativo           Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  clienteId String
  cliente   Cliente @relation(fields: [clienteId], references: [id], onDelete: Cascade)

  dispositivoId String?
  dispositivo   Dispositivo? @relation(fields: [dispositivoId], references: [id], onDelete: SetNull)

  @@index([clienteId])
  @@index([placa])
}

model Placa {
  id          String   @id @default(uuid())
  placa       String
  descricao   String?
  ativo       Boolean  @default(true)
  valorPadrao Decimal? @db.Decimal(10, 2)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  clienteId  String
  cliente    Cliente @relation(fields: [clienteId], references: [id])
  vendedorId String?
  vendedor   User?   @relation("PlacaVendedor", fields: [vendedorId], references: [id])

  boletos           Boleto[]
  boletosUnificados BoletoPlaca[]
}

model Carne {
  id             String    @id @default(uuid())
  tipo           TipoCarne
  efiCarneId     String?   @unique
  efiCarneLink   String?
  valorTotal     Decimal   @db.Decimal(10, 2)
  numeroParcelas Int       @default(1)
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  clienteId   String
  cliente     Cliente @relation(fields: [clienteId], references: [id])
  geradoPorId String
  geradoPor   User    @relation("CarneGeradoPor", fields: [geradoPorId], references: [id])
  vendedorId  String?
  vendedor    User?   @relation("CarneVendedor", fields: [vendedorId], references: [id])

  boletos Boleto[]
}

model Boleto {
  id            String       @id @default(uuid())
  numeroParcela Int
  valor         Decimal      @db.Decimal(10, 2)
  vencimento    DateTime
  status        StatusBoleto @default(PENDENTE)
  dataPagamento DateTime?
  valorPago     Decimal?     @db.Decimal(10, 2)
  efiChargeId   String?      @unique
  linkBoleto    String?
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt

  carneId       String
  carne         Carne        @relation(fields: [carneId], references: [id])
  placaId       String?
  placa         Placa?       @relation(fields: [placaId], references: [id])
  dispositivoId String?
  dispositivo   Dispositivo? @relation(fields: [dispositivoId], references: [id])

  placasUnificadas        BoletoPlaca[]
  dispositivosUnificados  BoletoDispositivo[]
  comissoes               ComissaoVendedor[]
  eventosNotificacoes     EventoNotificacao[]
  notificacoesFinanceiras NotificacaoFinanceiraEnvio[]
}

model BoletoPlaca {
  valorPlaca Decimal @db.Decimal(10, 2)

  boletoId String
  boleto   Boleto @relation(fields: [boletoId], references: [id])
  placaId  String
  placa    Placa  @relation(fields: [placaId], references: [id])

  @@id([boletoId, placaId])
}

model BoletoDispositivo {
  valorDispositivo Decimal @db.Decimal(10, 2)

  boletoId      String
  boleto        Boleto      @relation(fields: [boletoId], references: [id])
  dispositivoId String
  dispositivo   Dispositivo @relation(fields: [dispositivoId], references: [id])

  @@id([boletoId, dispositivoId])
}

model Dispositivo {
  id            String  @id @default(uuid())
  traccarId     Int?    @unique
  nome          String
  identificador String  @unique
  categoria     String?
  grupo         String?
  contato       String?
  ativo         Boolean @default(true)

  // Rastreador
  modeloRastreador   String?
  telefoneRastreador String?
  iccid              String?
  operadora          String?

  // Veículo
  placa           String?
  marca           String?
  modeloVeiculo   String?
  cor             String?
  ano             String?
  renavam         String?
  chassi          String?
  combustivel     String?
  localInstalacao String?
  instalador      String?

  // Configurações
  consumo                   String?
  limiteVelocidade          Float?
  senha                     String?
  ignorarOdometro           Boolean   @default(false)
  manutencaoAtiva           Boolean   @default(true)
  odometroSistemaMetros     Float?
  horimetroSistemaSegundos  Int       @default(0)
  telemetriaUltimaPosicaoEm DateTime?
  telemetriaUltimaLatitude  Float?
  telemetriaUltimaLongitude Float?
  telemetriaUltimaIgnicao   Boolean?

  // Imagem
  imagemUrl        String?
  imagemUrlCliente String?
  apelidoCliente   String?

  // Billing (equivalente a Placa)
  valorPadrao Decimal? @db.Decimal(10, 2)

  // Agrupamento visual no portal do cliente / app — permite dividir a frota em "Mapa 1" e "Mapa 2"
  mapa Int @default(1)

  // Tag BLE (para localização auxiliar via Bluetooth durante operações de resgate)
  enderecoMac String?

  // Integração IAPRO: quando o cliente é da IAPRO, controla se ESTE dispositivo aparece
  // no Mapa de Veículos da IAPRO (cliente pode ter veículos que não são protegidos lá).
  // Padrão desativado: só aparece no mapa da IAPRO quando o admin ativar explicitamente.
  exibirNoMapaIapro Boolean @default(false)

  clienteId   String?
  cliente     Cliente? @relation(fields: [clienteId], references: [id])
  vendedorId  String?
  vendedor    User?    @relation("DispositivoVendedor", fields: [vendedorId], references: [id])
  criadoPorId String
  criadoPor   User     @relation("DispositivoCriador", fields: [criadoPorId], references: [id])

  boletos                  Boleto[]
  boletosUnificados        BoletoDispositivo[]
  clientesVinculados       DispositivoCliente[]
  motoristasVinculados     MotoristaDispositivo[]
  preferenciasNotificacoes PreferenciaNotificacao[]
  eventosNotificacoes      EventoNotificacao[]
  estadosKmNotificacao     EstadoKmNotificacao[]
  manutencoesRegistros     ManutencaoRegistro[]
  manutencoesRecorrencias  ManutencaoRecorrencia[]
  recorrenciasData         ManutencaoRecorrenciaData[]
  geocercas                GeocercaDispositivo[]
  loginsPermitidos         ClienteLoginPlaca[]
  tagsBle                  TagBLE[]
  usuariosResgate          UsuarioResgateDispositivo[]
  iaproVeiculos            IaproVeiculo[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// Tag Bluetooth Low Energy associada a um dispositivo, usada para
// localizar fisicamente o veículo durante operações de resgate.
// Múltiplas tags podem ser cadastradas por dispositivo.
model TagBLE {
  id                     String   @id @default(uuid())
  dispositivoId          String
  apelido                String?
  mac                    String? // capturado no Android (iOS não expõe MAC por privacidade)
  nomeBleAdvertised      String? // fingerprint cross-platform (ex: "iTAG_A1B2")
  manufacturerCompanyId  Int? // BLE company identifier
  manufacturerDataHex    String? // bytes do manufacturer data em hex
  serviceUuids           Json? // ex: ["FFE0", "180A"]
  txPowerCalibrado       Int? // dBm @ 1m (default -59)
  iosPeripheralUuidCache Json     @default("{}") // { "deviceId iOS": "peripheralUUID" }
  createdAt              DateTime @default(now())
  updatedAt              DateTime @updatedAt

  dispositivo     Dispositivo                 @relation(fields: [dispositivoId], references: [id], onDelete: Cascade)
  usuariosResgate UsuarioResgateDispositivo[]

  @@unique([dispositivoId, mac])
  @@index([dispositivoId])
}

// Junção: quais dispositivos (e suas tags) um usuário de resgate pode acessar
model UsuarioResgateDispositivo {
  usuarioId     String
  dispositivoId String
  tagId         String?

  usuario     User        @relation(fields: [usuarioId], references: [id], onDelete: Cascade)
  dispositivo Dispositivo @relation(fields: [dispositivoId], references: [id], onDelete: Cascade)
  tag         TagBLE?     @relation(fields: [tagId], references: [id], onDelete: SetNull)

  @@id([usuarioId, dispositivoId])
  @@index([dispositivoId])
  @@index([tagId])
}

model Motorista {
  id            String   @id @default(uuid())
  nome          String
  identificador String?  @unique
  traccarId     Int?
  cnh           String?
  telefone      String?
  ativo         Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  dispositivosVinculados MotoristaDispositivo[]
}

model MotoristaDispositivo {
  motoristaId   String
  dispositivoId String
  motorista     Motorista   @relation(fields: [motoristaId], references: [id], onDelete: Cascade)
  dispositivo   Dispositivo @relation(fields: [dispositivoId], references: [id], onDelete: Cascade)

  @@id([motoristaId, dispositivoId])
}

model DispositivoCliente {
  dispositivoId String
  clienteId     String
  dispositivo   Dispositivo @relation(fields: [dispositivoId], references: [id], onDelete: Cascade)
  cliente       Cliente     @relation(fields: [clienteId], references: [id], onDelete: Cascade)

  @@id([dispositivoId, clienteId])
}

model ComissaoVendedor {
  id                 String    @id @default(uuid())
  valorReferencia    Decimal   @db.Decimal(10, 2)
  percentualAplicado Decimal   @db.Decimal(5, 2)
  valorComissao      Decimal   @db.Decimal(10, 2)
  pago               Boolean   @default(false)
  dataPagamento      DateTime? // snapshot quando o boleto/cliente é excluído
  createdAt          DateTime  @default(now())

  vendedorId String
  vendedor   User    @relation(fields: [vendedorId], references: [id])
  boletoId   String?
  boleto     Boleto? @relation(fields: [boletoId], references: [id])
}

model PagamentoComissao {
  id              String   @id @default(uuid())
  vendedorId      String
  vendedor        User     @relation(fields: [vendedorId], references: [id])
  mes             String // formato YYYY-MM
  valor           Decimal  @db.Decimal(10, 2)
  pago            Boolean  @default(false)
  comprovante     String? // caminho relativo do arquivo (ex: "uploads/comprovantes/uuid.pdf")
  comprovanteMime String? // MIME type do arquivo
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@unique([vendedorId, mes])
}

model Configuracoes {
  id                    String   @id @default("1")
  // Campos legados de comissão por faixa (menor/maior). Mantidos para
  // compatibilidade histórica — o cálculo atual usa a tabela RegraComissao.
  percentualMenor       Decimal  @default(12.50) @db.Decimal(5, 2)
  percentualMaior       Decimal  @default(18.00) @db.Decimal(5, 2)
  valorReferencia       Decimal  @default(50.00) @db.Decimal(10, 2)
  multaPercentual       Decimal  @default(5.00) @db.Decimal(5, 2)
  jurosDiarios          Decimal  @default(0.33) @db.Decimal(5, 2)
  representanteNome     String?
  representanteEmail    String?
  representanteTelefone String?
  representanteCpf      String?
  updatedAt             DateTime @updatedAt
}

// Tabela de comissões por valor exato de cobrança.
// Regra: "tudo que for = a X recebe X% de comissão".
// Uma cobrança cujo valor não corresponda exatamente a nenhuma regra
// NÃO gera comissão (0%).
model RegraComissao {
  id         String   @id @default(uuid())
  valor      Decimal  @db.Decimal(10, 2) // valor exato da cobrança (R$)
  percentual Decimal  @db.Decimal(5, 2)  // % de comissão aplicado
  ativo      Boolean  @default(true)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}

model ClienteLogin {
  id               String   @id @default(cuid())
  clienteId        String
  email            String   @unique
  // CPF/CNPJ opcional (somente dígitos) — permite que o sub-usuário entre com ele no login
  cpfCnpj          String?
  senhaHash        String
  ativo            Boolean  @default(true)
  prefs            Json     @default("{}")
  avatarUrl        String?
  logoUrl          String?
  // Tipo de login: 'responsavel' = login original do cliente (acesso total),
  // 'vinculado' = sub-usuário criado pelo responsável (acesso limitado por permissões/placas)
  tipo             String   @default("responsavel")
  // Nome exibido nas telas para sub-usuário. Para responsável, fica null e usamos Cliente.nome.
  nome             String?
  // Rótulo livre para o perfil do sub-usuário (ex: "Locatário", "Mecânico", "Motorista")
  perfil           String?
  // Permissões granulares (JSON). Vazio para responsável (acesso total implícito).
  // Estrutura: { rastreamento: {...}, manutencao: {...}, relatorio: {...} }
  permissoes       Json     @default("{}")
  // Quem criou esse login (null para responsável criado pelo admin)
  criadoPorLoginId String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  cliente                  Cliente                      @relation(fields: [clienteId], references: [id], onDelete: Cascade)
  criadoPorLogin           ClienteLogin?                @relation("ClienteLoginCriador", fields: [criadoPorLoginId], references: [id], onDelete: SetNull)
  loginsCriados            ClienteLogin[]               @relation("ClienteLoginCriador")
  placasPermitidas         ClienteLoginPlaca[]
  preferenciasNotificacoes PreferenciaNotificacao[]
  eventosNotificacoes      EventoNotificacao[]
  estadosKmNotificacao     EstadoKmNotificacao[]
  manutencoesRegistros     ManutencaoRegistro[]
  manutencoesRecorrencias  ManutencaoRecorrencia[]
  recorrenciasData         ManutencaoRecorrenciaData[]
  appPushTokens            AppPushToken[]
  notificacoesFinanceiras  NotificacaoFinanceiraEnvio[]

  @@index([clienteId, tipo])
}

// Tabela junção: quais dispositivos um sub-usuário ('vinculado') pode acessar.
// Para 'responsavel' a lista é ignorada (acesso a todos do cliente).
model ClienteLoginPlaca {
  clienteLoginId String
  dispositivoId  String

  clienteLogin ClienteLogin @relation(fields: [clienteLoginId], references: [id], onDelete: Cascade)
  dispositivo  Dispositivo  @relation(fields: [dispositivoId], references: [id], onDelete: Cascade)

  @@id([clienteLoginId, dispositivoId])
  @@index([dispositivoId])
}

model AppPushToken {
  id             String   @id @default(uuid())
  clienteLoginId String
  token          String   @unique
  plataforma     String?
  deviceId       String?
  ativo          Boolean  @default(true)
  ultimoErro     String?
  lastSeenAt     DateTime @default(now())
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  clienteLogin ClienteLogin @relation(fields: [clienteLoginId], references: [id], onDelete: Cascade)

  @@index([clienteLoginId, ativo])
}

model PreferenciaNotificacao {
  id                 String   @id @default(uuid())
  clienteLoginId     String
  dispositivoId      String
  tipoEvento         String // ignitionOn, ignitionOff, geofenceEnter, geofenceExit, overspeed, powerCut, kmExcedida, kmReduzida, trocaOleo
  web                Boolean  @default(false)
  app                Boolean  @default(false)
  email              Boolean  @default(false)
  overspeedLimit     Int?     @default(100)
  kmMaximo30Dias     Int?
  diaRenovacaoMes    Int?
  kmMinimo7Dias      Int?
  diaSemanaRenovacao Int?
  kmTrocaOleo        Int?
  semAtualizacaoHoras Int?    @default(3) // Horas sem posição p/ disparar "semAtualizacao" (escolha do usuário)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  clienteLogin ClienteLogin @relation(fields: [clienteLoginId], references: [id], onDelete: Cascade)
  dispositivo  Dispositivo  @relation(fields: [dispositivoId], references: [id], onDelete: Cascade)

  @@unique([clienteLoginId, dispositivoId, tipoEvento])
}

model EstadoKmNotificacao {
  id                  String   @id @default(uuid())
  clienteLoginId      String
  dispositivoId       String
  tipoEvento          String // kmExcedida, kmReduzida, trocaOleo
  kmBaseMetros        Float    @default(0)
  dataBase            DateTime @default(now())
  notificacaoEnviada  Boolean  @default(false)
  ultimaNotificacaoKm Float    @default(-9999)
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  clienteLogin ClienteLogin @relation(fields: [clienteLoginId], references: [id], onDelete: Cascade)
  dispositivo  Dispositivo  @relation(fields: [dispositivoId], references: [id], onDelete: Cascade)

  @@unique([clienteLoginId, dispositivoId, tipoEvento])
}

model EventoNotificacao {
  id             String   @id @default(uuid())
  clienteLoginId String
  dispositivoId  String?
  boletoId       String?
  tipoEvento     String
  origemTipo     String?
  origemId       String?
  adminEvento    Boolean  @default(false)
  mensagem       String
  latitude       Float?
  longitude      Float?
  endereco       String?
  velocidade     Float?
  lido           Boolean  @default(false)
  createdAt      DateTime @default(now())

  clienteLogin ClienteLogin @relation(fields: [clienteLoginId], references: [id], onDelete: Cascade)
  dispositivo  Dispositivo? @relation(fields: [dispositivoId], references: [id], onDelete: Cascade)
  boleto       Boleto?      @relation(fields: [boletoId], references: [id], onDelete: Cascade)

  @@index([clienteLoginId, createdAt])
  @@index([boletoId])
  @@index([origemTipo, createdAt])
  @@index([adminEvento, createdAt])
}

model NotificacaoFinanceiraEnvio {
  id             String   @id @default(uuid())
  clienteLoginId String
  boletoId       String
  tipo           String
  dataReferencia DateTime
  createdAt      DateTime @default(now())

  clienteLogin ClienteLogin @relation(fields: [clienteLoginId], references: [id], onDelete: Cascade)
  boleto       Boleto       @relation(fields: [boletoId], references: [id], onDelete: Cascade)

  @@unique([clienteLoginId, boletoId, tipo, dataReferencia])
  @@index([tipo, dataReferencia])
}

model ManutencaoRegistro {
  id               String   @id @default(uuid())
  dispositivoId    String
  clienteLoginId   String?
  criadoPorAdminId String?
  titulo           String
  tipo             String   @default("preventiva")
  descricao        String?  @db.Text
  dataRealizacao   DateTime
  kmRealizacao     Float?
  custo            Decimal? @db.Decimal(10, 2)
  oficina          String?
  notas            String?  @db.Text
  fotos            Json     @default("[]")
  origem           String   @default("CLIENTE")
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  dispositivo    Dispositivo   @relation(fields: [dispositivoId], references: [id], onDelete: Cascade)
  clienteLogin   ClienteLogin? @relation(fields: [clienteLoginId], references: [id], onDelete: SetNull)
  criadoPorAdmin User?         @relation("ManutencaoAdmin", fields: [criadoPorAdminId], references: [id], onDelete: SetNull)
}

model ManutencaoRecorrencia {
  id                    String   @id @default(uuid())
  dispositivoId         String
  clienteLoginId        String?
  criadoPorAdminId      String?
  titulo                String
  descricao             String?
  intervaloKm           Int
  kmBase                Float    @default(0)
  alerta50Enviado       Boolean  @default(false)
  alerta25Enviado       Boolean  @default(false)
  alerta0Enviado        Boolean  @default(false)
  ultimaAlertaPostDueKm Float    @default(-1)
  ativa                 Boolean  @default(true)
  origem                String   @default("CLIENTE")
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  dispositivo    Dispositivo   @relation(fields: [dispositivoId], references: [id], onDelete: Cascade)
  clienteLogin   ClienteLogin? @relation(fields: [clienteLoginId], references: [id], onDelete: SetNull)
  criadoPorAdmin User?         @relation("RecorrenciaAdmin", fields: [criadoPorAdminId], references: [id], onDelete: SetNull)
}

model ManutencaoRecorrenciaData {
  id               String  @id @default(uuid())
  dispositivoId    String
  clienteLoginId   String?
  criadoPorAdminId String?
  titulo           String
  descricao        String? @db.Text

  // AVULSA | INTERVALO | SEMANAL | MENSAL | ANUAL
  tipoRecorrencia String   @default("AVULSA")
  dataReferencia  DateTime // próxima ocorrência

  intervaloDias Int? // INTERVALO: a cada N dias
  diasSemana    Json? // SEMANAL: [0-6] (0=dom)
  diaDoMes      Int? // MENSAL/ANUAL: dia (1-31)
  mesDoAno      Int? // ANUAL: mês (1-12)

  alerta7dEnviado    Boolean   @default(false)
  alerta4dEnviado    Boolean   @default(false)
  alerta2dEnviado    Boolean   @default(false)
  alerta1dEnviado    Boolean   @default(false)
  alertaDiaEnviado   Boolean   @default(false)
  ultimoAlertaPosDue DateTime?

  ciclosCompletos  Int     @default(0)
  ativa            Boolean @default(true)
  origem           String  @default("CLIENTE")
  canalNotificacao String  @default("todos") // app | email | todos

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  dispositivo    Dispositivo   @relation(fields: [dispositivoId], references: [id], onDelete: Cascade)
  clienteLogin   ClienteLogin? @relation(fields: [clienteLoginId], references: [id], onDelete: SetNull)
  criadoPorAdmin User?         @relation("RecorrenciaDataAdmin", fields: [criadoPorAdminId], references: [id], onDelete: SetNull)
}

model Geocerca {
  id               String    @id @default(cuid())
  traccarId        Int       @unique
  nome             String
  descricao        String?
  area             String    @db.Text
  tipo             String    @default("circulo")
  origemTipo       String // "ADMIN" | "CLIENTE"
  clienteId        String?
  visivelCliente   Boolean   @default(false)
  notificarCliente Boolean   @default(false)
  sistemasNotif    Json?
  dataInicio       DateTime?
  ativa            Boolean   @default(true)
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  dispositivos GeocercaDispositivo[]
  cliente      Cliente?              @relation(fields: [clienteId], references: [id])
}

model GeocercaDispositivo {
  geocercaId    String
  dispositivoId String

  geocerca    Geocerca    @relation(fields: [geocercaId], references: [id], onDelete: Cascade)
  dispositivo Dispositivo @relation(fields: [dispositivoId], references: [id])

  @@id([geocercaId, dispositivoId])
}

model Contrato {
  id                   String    @id @default(uuid())
  tipo                 String // "PF_COM_ASSISTENCIA" | "PF_SEM_ASSISTENCIA" | "PJ_COM_ASSISTENCIA" | "PJ_SEM_ASSISTENCIA"
  clienteId            String
  cliente              Cliente   @relation(fields: [clienteId], references: [id])
  fiadores             Json? // [{nome, cpf, rg, nacionalidade, profissao, estadoCivil, dataNascimento, email, telefone, cep, logradouro, numero, complemento, bairro, cidade, estado}]
  testemunhas          Json // [{nome, cpf, email, telefone, assinarDigital: bool}]
  htmlConteudo         String    @db.Text
  metodoAutenticacao   String // "token_email" | "token_whatsapp" | "token_sms" | "handwritten"
  status               String    @default("RASCUNHO")
  clicksignEnvelopeId  String?
  clicksignDocumentoId String?
  signatarios          Json? // [{nome, signerId, link, tipo: "cliente"|"socio"|"fiador"|"testemunha"|"agillock"}]
  criadoPorId          String
  criadoPor            User      @relation("ContratoCriador", fields: [criadoPorId], references: [id])
  assinadoEm           DateTime?
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt
}
