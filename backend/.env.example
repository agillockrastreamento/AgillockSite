# Banco de dados
DATABASE_URL="postgresql://agillock_user:senha_aqui@localhost:5432/agillock"
POSTGRES_PASSWORD=senha_aqui

# JWT — use uma string longa e aleatória
JWT_SECRET="troque_por_uma_chave_secreta_longa"

# EFI Bank (preencher na etapa 3)
EFI_CLIENT_ID=
EFI_CLIENT_SECRET=
EFI_CERT_PATH=./cert/certificado.p12
EFI_CERT_PASSWORD=
EFI_SANDBOX=true
WEBHOOK_URL=https://api.agillock.com.br/api/efi/webhook

# CORS — origens permitidas (separar por vírgula se houver mais de uma)
# Desenvolvimento: CORS_ORIGIN=http://localhost:5500,http://127.0.0.1:5500
# Produção:        CORS_ORIGIN=https://agillock.com.br,https://www.agillock.com.br
CORS_ORIGIN=http://localhost:5500,http://127.0.0.1:5500

# Porta da API
PORT=3000

# Seed do admin — preencher com as credenciais de produção
ADMIN_EMAIL=seu_email_admin_aqui
ADMIN_SENHA=sua_senha_segura_aqui

# Traccar
TRACCAR_URL=http://traccar:8082
TRACCAR_USER=seu_email_admin_traccar
TRACCAR_PASSWORD=sua_senha_traccar

# Google Maps
GOOGLE_MAPS_JS_API_KEY=sua_chave_google_maps_aqui
GOOGLE_MAPS_GEOCODING_API_KEY=sua_chave_google_geocoding_server_aqui

# Reverse geocoding — cadeia de provedores, tentados em ordem até um responder.
# Valores: google | nominatim | photon. Vazio = comportamento histórico
# (google se houver chave acima, com nominatim de fallback).
# Após subir o Photon, usar: GEOCODER_PROVIDER=photon,nominatim
GEOCODER_PROVIDER=
PHOTON_URL=http://photon:2322
NOMINATIM_URL=https://nominatim.openstreetmap.org
GEOCODER_TIMEOUT_MS=6000
# Dias até uma entrada do cache ser reconsultada.
GEOCODE_CACHE_TTL_DIAS=180

# Configurações de E-mail (Hostinger)
SMTP_HOST=smtp.hostinger.com
SMTP_PORT=465
SMTP_USER=seu-email@agillockrastreamento.com.br
SMTP_PASS=sua-senha-do-email

# URL Pública do sistema (para links e imagens no e-mail)
PUBLIC_URL=https://agillockrastreamento.com.br

# ─── Integração IAPRO ────────────────────────────────────────
# URL base da API da IAPRO (com /api/v1). Dev com backend em Docker: http://host.docker.internal:4000/api/v1
IAPRO_API_URL=http://localhost:4000/api/v1
# Chave enviada PELA Ágil Lock à IAPRO (header x-api-key) — igual a AGILLOCK_WEBHOOK_KEY no .env da IAPRO
IAPRO_API_KEY=
# Chave esperada DA IAPRO nas rotas /api/integracao/iapro — igual a AGILLOCK_API_KEY no .env da IAPRO
IAPRO_WEBHOOK_KEY=
# (Opcional) URL pública do site da IAPRO p/ a "Cotação Proteção Veicular". Dispensável: em produção
# usa https://iaproprotecaoveicular.tech e, quando IAPRO_API_URL aponta p/ localhost, usa http://localhost:3000.
# IAPRO_PUBLIC_URL=

# ─── Sistema Anterior (monitorando.me) — trazer dispositivos ─────────────────
# Credencial (Basic Auth) usada pela tela admin "Trazer Dispositivos do Sistema Anterior".
# Fica SOMENTE no servidor — nunca vai para o navegador.
ANTERIOR_API_URL=https://server.monitorando.me/api
ANTERIOR_USER=agillockrastreamento@gmail.com
ANTERIOR_PASS=
# (Opcional) Comando GT06 de troca de servidor. Padrão aponta para a VPS da AgilLock.
# ANTERIOR_REAPONTE_COMANDO=SERVER,0,72.62.13.73,5023,0#
